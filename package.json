{
  "name": "entre-chat",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "format": "prettier --write src functions/src tests scripts *.ts *.js *.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --project demo-entre --only firestore \"vitest run --config vitest.rules.config.ts\"",
    "test:integration": "firebase emulators:exec --project demo-entre --only auth,firestore \"vitest run --config vitest.integration.config.ts\"",
    "test:e2e": "playwright test",
    "test:docker": "playwright test --config playwright.docker.config.ts",
    "test:emulators": "firebase emulators:exec --project demo-entre --only auth,firestore \"node scripts/verify-emulators.mjs\"",
    "emulators": "firebase emulators:start --project demo-entre --only auth,firestore"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "firebase": "^12.19.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.58.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.19.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "firebase-tools": "^15.30.2",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
